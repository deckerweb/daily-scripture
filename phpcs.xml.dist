<?xml version="1.0"?>
<ruleset name="Daily Scripture">
    <description>WordPress standards; original namespace autoloader preserves its class filenames.</description>
    <!-- Shared upstream library is shipped byte-for-byte; integration code is checked below. -->
    <exclude-pattern>*/includes/deckerweb-github-release-updater-v1.php</exclude-pattern>
    <file>daily-scripture.php</file>
    <file>uninstall.php</file>
    <file>src</file>
    <arg name="extensions" value="php"/>
    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    </rule>
    <config name="minimum_supported_wp_version" value="6.6"/>
</ruleset>
